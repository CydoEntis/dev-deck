{
  "hosts": ["claude", "codex"],
  "models": {
    "claude": { "planner": "", "builder": "", "reviewer": "" },
    "codex":  { "planner": "", "builder": "", "reviewer": "" }
  },
  "_readme": [
    "Copy this file to dev-deck.config.json (git-ignored).",
    "",
    "models: one map per host. The installer reads models[<host>][<role>] for",
    "  each host it writes role files for.",
    "  - leave \"\" to inherit the host's default model",
    "  - Claude Code: full model IDs, e.g. \"claude-opus-5-5\", \"claude-sonnet-5-5\",",
    "    or the aliases \"opus\" | \"sonnet\" | \"haiku\"",
    "  - codex: model names as the host expects them",
    "  - keep reviewer a DIFFERENT model family than builder",
    "",
    "hosts: which agent hosts the installer writes role files for.",
    "  allowed: claude, codex",
    "  claude   -> ~/.claude/agents/<role>.md",
    "  codex    -> ~/.codex/agents/<role>.toml"
  ]
}
